// Skema data (docs/DATABASE.md). Tiket 02 baru memuat `pengguna` dan `audit_log`;
// tabel lain ditambahkan oleh tiket pemiliknya bersama migrasinya.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Peran {
  ADMIN
  OPERATOR
}

/// Akun Admin dan Operator. Tidak dihapus, hanya dinonaktifkan (DATABASE §8).
model Pengguna {
  id                 String    @id @default(cuid(2))
  /// Huruf kecil, 3-32 karakter [a-z0-9._-]; CHECK constraint ada di migrasi.
  username           String    @unique
  nama               String
  passwordHash       String    @map("password_hash")
  peran              Peran
  aktif              Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Naik setiap perubahan oleh Admin (optimistic concurrency, API.md §1).
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLog      AuditLog[]
  periodeDibuat Periode[]

  @@map("pengguna")
}

enum StatusPeriode {
  DRAF
  TERKUNCI
  DIUNDI
  FINAL
  DIPUBLIKASI
  DIBATALKAN
}

enum KodeWilayah {
  W1
  W2
}

/// Satu penyelenggaraan undian. Hanya satu periode aktif (selain DIPUBLIKASI dan DIBATALKAN):
/// dijaga index unik parsial `periode_satu_aktif` yang ditulis manual di migrasi.
model Periode {
  id           String        @id @default(cuid(2))
  /// Unik, mis. `undian-umroh-2026`; tidak berubah saat judul diubah.
  slug         String        @unique
  judul        String
  tahunAwal    Int           @default(2022) @map("tahun_awal")
  tahunAkhir   Int           @default(2026) @map("tahun_akhir")
  /// Inklusif. Hanya boleh berubah saat DRAF (DECISIONS 005). Nilai bawaan diisi aplikasi
  /// (`BATAS_LUNAS_BAWAAN`), bukan default DB, agar tidak bergantung zona waktu server.
  batasLunas   DateTime      @map("batas_lunas") @db.Timestamptz(3)
  tanggalAcara DateTime?     @map("tanggal_acara") @db.Date
  lokasiAcara  String?       @map("lokasi_acara")
  status       StatusPeriode @default(DRAF)
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(3)
  /// Wajib bila DIBATALKAN (CHECK constraint di migrasi).
  alasanBatal  String?       @map("alasan_batal")
  /// Naik setiap perubahan (optimistic concurrency, API.md §1).
  version      Int           @default(1)
  createdById  String        @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Pengguna  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  wilayah   Wilayah[]

  @@map("periode")
}

/// Dua wilayah per periode (W1, W2), dibuat otomatis bersama periodenya.
model Wilayah {
  id        String      @id @default(cuid(2))
  periodeId String      @map("periode_id")
  kode      KodeWilayah
  nama      String

  periode Periode @relation(fields: [periodeId], references: [id], onDelete: Restrict)

  @@unique([periodeId, kode])
  @@map("wilayah")
}

/// Jejak aksi penting. Append-only: trigger database menolak UPDATE, DELETE, dan TRUNCATE.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  /// Kosong untuk aksi publik, sistem, dan login gagal.
  aktorId    String?  @map("aktor_id")
  /// Username, atau `publik` / `sistem`.
  aktorLabel String   @map("aktor_label")
  aksi       String
  targetTipe String   @map("target_tipe")
  targetId   String?  @map("target_id")
  /// Ringkasan dan ID saja; tidak pernah NIK, kata sandi, atau token.
  payload    Json     @default("{}")
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent") @db.VarChar(256)

  aktor Pengguna? @relation(fields: [aktorId], references: [id], onDelete: Restrict)

  @@index([at(sort: Desc)])
  @@index([aksi, at(sort: Desc)])
  @@index([aktorId, at(sort: Desc)])
  @@map("audit_log")
}
