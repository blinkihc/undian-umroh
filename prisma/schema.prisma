// Skema data (docs/DATABASE.md). Tiket 02 baru memuat `pengguna` dan `audit_log`;
// tabel lain ditambahkan oleh tiket pemiliknya bersama migrasinya.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Peran {
  ADMIN
  OPERATOR
}

/// Akun Admin dan Operator. Tidak dihapus, hanya dinonaktifkan (DATABASE §8).
model Pengguna {
  id                 String    @id @default(cuid(2))
  /// Huruf kecil, 3-32 karakter [a-z0-9._-]; CHECK constraint ada di migrasi.
  username           String    @unique
  nama               String
  passwordHash       String    @map("password_hash")
  peran              Peran
  aktif              Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Naik setiap perubahan oleh Admin (optimistic concurrency, API.md §1).
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLog        AuditLog[]
  periodeDibuat   Periode[]
  imporDibuat     Impor[]
  snapshotDikunci Snapshot[]

  @@map("pengguna")
}

enum StatusPeriode {
  DRAF
  TERKUNCI
  DIUNDI
  FINAL
  DIPUBLIKASI
  DIBATALKAN
}

enum KodeWilayah {
  W1
  W2
}

/// Satu penyelenggaraan undian. Hanya satu periode aktif (selain DIPUBLIKASI dan DIBATALKAN):
/// dijaga index unik parsial `periode_satu_aktif` yang ditulis manual di migrasi.
model Periode {
  id           String        @id @default(cuid(2))
  /// Unik, mis. `undian-umroh-2026`; tidak berubah saat judul diubah.
  slug         String        @unique
  judul        String
  tahunAwal    Int           @default(2022) @map("tahun_awal")
  tahunAkhir   Int           @default(2026) @map("tahun_akhir")
  /// Inklusif. Hanya boleh berubah saat DRAF (DECISIONS 005). Nilai bawaan diisi aplikasi
  /// (`BATAS_LUNAS_BAWAAN`), bukan default DB, agar tidak bergantung zona waktu server.
  batasLunas   DateTime      @map("batas_lunas") @db.Timestamptz(3)
  tanggalAcara DateTime?     @map("tanggal_acara") @db.Date
  lokasiAcara  String?       @map("lokasi_acara")
  status       StatusPeriode @default(DRAF)
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(3)
  /// Wajib bila DIBATALKAN (CHECK constraint di migrasi).
  alasanBatal  String?       @map("alasan_batal")
  /// Naik setiap perubahan (optimistic concurrency, API.md §1).
  version      Int           @default(1)
  createdById  String        @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Pengguna           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  wilayah   Wilayah[]
  impor     Impor[]
  peserta   Peserta[]
  kecamatan KecamatanWilayah[]
  snapshot  Snapshot?

  @@map("periode")
}

/// Riwayat setiap impor; hanya impor terakhir `aktif` (index unik parsial `impor_satu_aktif`).
model Impor {
  id           String   @id @default(cuid(2))
  periodeId    String   @map("periode_id")
  namaFile     String   @map("nama_file")
  /// SHA-256 hex huruf kecil dari file mentah; file sendiri tidak disimpan (SECURITY §8).
  fileSha256   String   @map("file_sha256")
  totalBaris   Int      @map("total_baris")
  jumlahLolos  Int      @map("jumlah_lolos")
  jumlahGugur  Int      @map("jumlah_gugur")
  /// `RingkasanImpor` (src/lib/domain/impor.ts) tanpa total yang sudah punya kolom sendiri.
  ringkasan    Json
  aktif        Boolean  @default(true)
  importedById String   @map("imported_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  periode    Periode   @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  importedBy Pengguna  @relation(fields: [importedById], references: [id], onDelete: Restrict)
  peserta    Peserta[]

  @@index([periodeId, createdAt(sort: Desc)])
  @@map("impor")
}

/// Setiap baris data impor aktif (lolos maupun gugur). NOP sengaja tidak unik: NOP ganda
/// harus tersimpan agar dapat dilaporkan.
model Peserta {
  id           String    @id @default(cuid(2))
  periodeId    String    @map("periode_id")
  imporId      String    @map("impor_id")
  /// Nomor baris di file (header = 1).
  baris        Int
  nop          String
  /// iv(12) || ciphertext || tag(16), AES-256-GCM. Null bila sel NIK kosong.
  nikEnc       Bytes?    @map("nik_enc")
  nikMasked    String    @map("nik_masked")
  nikValid     Boolean   @map("nik_valid")
  nama         String
  alamatWp     String    @map("alamat_wp")
  alamatOp     String    @map("alamat_op")
  kecamatanRaw String    @map("kecamatan_raw")
  kecamatan    String
  kelurahan    String
  lunas2022    DateTime? @map("lunas_2022") @db.Timestamptz(3)
  lunas2023    DateTime? @map("lunas_2023") @db.Timestamptz(3)
  lunas2024    DateTime? @map("lunas_2024") @db.Timestamptz(3)
  lunas2025    DateTime? @map("lunas_2025") @db.Timestamptz(3)
  lunas2026    DateTime? @map("lunas_2026") @db.Timestamptz(3)
  /// Nilai sel asli per tahun, mis. `{ "2022": "29/06/2022 14:14:36" }`.
  lunasRaw     Json      @map("lunas_raw")
  eligible     Boolean
  alasan       String[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  periode         Periode          @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  impor           Impor            @relation(fields: [imporId], references: [id], onDelete: Cascade)
  snapshotPeserta SnapshotPeserta?

  @@index([periodeId, eligible])
  @@index([periodeId, kecamatan])
  @@index([periodeId, nop])
  @@index([alasan], type: Gin)
  /// Btree biasa: `text_pattern_ops` tidak dapat dibaca balik oleh Prisma (selalu drift).
  @@index([periodeId, nama])
  @@map("peserta")
}

/// Dua wilayah per periode (W1, W2), dibuat otomatis bersama periodenya.
model Wilayah {
  id        String      @id @default(cuid(2))
  periodeId String      @map("periode_id")
  kode      KodeWilayah
  nama      String

  periode   Periode            @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  kecamatan KecamatanWilayah[]

  @@unique([periodeId, kode])
  @@map("wilayah")
}

/// Pemetaan kecamatan (hasil normalizeKecamatan) ke wilayah. Baris dibuat otomatis untuk setiap
/// kecamatan yang muncul saat impor; pemetaan lama dipertahankan saat impor ulang.
model KecamatanWilayah {
  id        String  @id @default(cuid(2))
  periodeId String  @map("periode_id")
  kecamatan String
  /// Null = belum dipetakan. Selalu wilayah milik periode yang sama (dijaga layanan wilayah).
  wilayahId String? @map("wilayah_id")

  periode Periode  @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  wilayah Wilayah? @relation(fields: [wilayahId], references: [id], onDelete: Restrict)

  @@unique([periodeId, kecamatan])
  @@map("kecamatan_wilayah")
}

/// Jejak aksi penting. Append-only: trigger database menolak UPDATE, DELETE, dan TRUNCATE.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  /// Kosong untuk aksi publik, sistem, dan login gagal.
  aktorId    String?  @map("aktor_id")
  /// Username, atau `publik` / `sistem`.
  aktorLabel String   @map("aktor_label")
  aksi       String
  targetTipe String   @map("target_tipe")
  targetId   String?  @map("target_id")
  /// Ringkasan dan ID saja; tidak pernah NIK, kata sandi, atau token.
  payload    Json     @default("{}")
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent") @db.VarChar(256)

  aktor Pengguna? @relation(fields: [aktorId], references: [id], onDelete: Restrict)

  @@index([at(sort: Desc)])
  @@index([aksi, at(sort: Desc)])
  @@index([aktorId, at(sort: Desc)])
  @@map("audit_log")
}

/// Bukti penguncian daftar peserta lolos (DATABASE §3). File JSON kanonik disimpan di storage.
/// Tabel append-only: trigger database menolak UPDATE dan DELETE.
model Snapshot {
  id         String   @id @default(cuid(2))
  periodeId  String   @unique @map("periode_id")
  hash       String
  jumlahW1   Int      @map("jumlah_w1")
  jumlahW2   Int      @map("jumlah_w2")
  filePath   String   @map("file_path")
  lockedById String   @map("locked_by_id")
  lockedAt   DateTime @default(now()) @map("locked_at") @db.Timestamptz(3)

  periode  Periode           @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  lockedBy Pengguna          @relation(fields: [lockedById], references: [id], onDelete: Restrict)
  peserta  SnapshotPeserta[]

  @@map("snapshot")
}

/// Indeks peserta yang terkunci (DATABASE §3), urut = 1..N berdasarkan NOP naik.
/// Tabel append-only: trigger database menolak UPDATE dan DELETE.
model SnapshotPeserta {
  snapshotId String      @map("snapshot_id")
  urut       Int
  pesertaId  String      @unique @map("peserta_id")
  nop        String
  wilayah    KodeWilayah

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  peserta  Peserta  @relation(fields: [pesertaId], references: [id], onDelete: Restrict)

  @@id([snapshotId, urut])
  @@unique([snapshotId, nop])
  @@map("snapshot_peserta")
}

