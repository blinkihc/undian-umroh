# Salin ke .env lalu isi nilainya. JANGAN commit .env dan jangan pakai nilai produksi di lokal.
# Daftar lengkap variabel dan aturannya: docs/ENVIRONMENT.md

NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Undian Umroh PBB OKU Selatan"
NEXT_PUBLIC_APP_VERSION=0.1.0
LOG_LEVEL=debug
TZ=Asia/Jakarta

DATABASE_URL=postgresql://undian:undian@localhost:5432/undian?schema=public
DATABASE_URL_TEST=postgresql://undian:undian@localhost:5433/undian_test
POSTGRES_USER=undian
POSTGRES_PASSWORD=ganti-di-produksi
POSTGRES_DB=undian

# Tiga kunci berikut wajib base64 dari 32 byte acak, berbeda untuk setiap lingkungan.
# Bangkitkan dengan: openssl rand -base64 32
# Tanpa openssl: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NIK_ENCRYPTION_KEY=
CAPTCHA_HMAC_KEY=
SEED_ADMIN_USERNAME=admin.bapenda
SEED_ADMIN_PASSWORD=

STORAGE_DIR=./.storage

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

BACKUP_AGE_RECIPIENT=
BACKUP_DIR=./.backups
